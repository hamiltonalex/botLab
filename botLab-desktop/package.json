{
  "name": "botlab-desktop",
  "version": "0.3.1",
  "description": "Live paper-trading desktop app for delta-neutral funding-rate arbitrage (GMX V2 x Hyperliquid). Phase 1: public read-only data, no orders, no keys.",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test",
    "oracle": "electron scripts/selector-oracle.mjs",
    "smoke": "node scripts/smoke-live.mjs",
    "smoke:scan": "node scripts/smoke-scan.mjs",
    "report:scan": "node scripts/report-scan.mjs",
    "report:records": "node scripts/report-records.mjs",
    "eval:sell": "node scripts/eval-sell.mjs",
    "eval:relax": "node scripts/eval-relax.mjs",
    "eval:score": "node scripts/eval-score.mjs",
    "eval:buy": "node scripts/eval-buy.mjs",
    "eval:toll": "node scripts/eval-toll.mjs",
    "eval:preset": "node --max-old-space-size=6000 scripts/eval-preset.mjs",
    "hist:download": "node scripts/hist-download.mjs",
    "hist:build": "node --max-old-space-size=6000 scripts/hist-build.mjs",
    "hist:validate": "node scripts/hist-validate.mjs",
    "hist:backtest": "node --max-old-space-size=8000 scripts/hist-backtest.mjs",
    "hist:sell": "node --max-old-space-size=10000 scripts/hist-sell.mjs",
    "hist:sweep": "node scripts/hist-sweep.mjs",
    "hist:sellhedge": "node --max-old-space-size=12000 scripts/hist-sellhedge.mjs",
    "margin:path": "node --max-old-space-size=12000 scripts/margin-path.mjs",
    "parity:sellhedge": "node --max-old-space-size=12000 scripts/parity-sellhedge.mjs",
    "hist:repack": "node scripts/hist-repack.mjs",
    "e2e:ui": "node scripts/e2e-ui.mjs",
    "e2e:chain": "node scripts/e2e-chain.mjs",
    "verify:loris": "node scripts/verify-loris.mjs",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "check:tag": "node scripts/check-tag-version.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "make:icon": "node scripts/make-icon.mjs"
  },
  "author": "Alex Hamilton",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.61.1"
  },
  "build": {
    "appId": "com.hamiltonalex.botlab",
    "productName": "BotLab",
    "artifactName": "BotLab-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hamiltonalex",
        "repo": "botLab"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
